<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>越狱插件键盘</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>翻译引擎（百度翻译）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>百度 App ID</string>
			<key>key</key>
			<string>YYBaiduAppID</string>
			<key>placeholder</key>
			<string>在 fanyi-api.baidu.com 申请</string>
			<key>default</key>
			<string></string>
			<key>isSecure</key>
			<false/>
			<key>keyboardType</key>
			<string>Alphabet</string>
			<key>autoCorrectionType</key>
			<string>No</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>百度密钥</string>
			<key>key</key>
			<string>YYBaiduSecretKey</string>
			<key>placeholder</key>
			<string>申请后获取</string>
			<key>default</key>
			<string></string>
			<key>isSecure</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>去百度翻译开放平台申请</string>
			<key>url</key>
			<string>https://fanyi-api.baidu.com/</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>翻译源策略</string>
			<key>value</key>
			<string>百度优先，失败自动切谷歌</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>翻译行为</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用翻译功能</string>
			<key>key</key>
			<string>YYTranslateEnabled</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSMultiValueCell</string>
			<key>label</key>
			<string>默认目标语言</string>
			<key>key</key>
			<string>YYDefaultTargetLang</string>
			<key>default</key>
			<string>auto</string>
			<key>titles</key>
			<array>
				<string>自动</string>
				<string>中文</string>
				<string>英文</string>
				<string>日文</string>
				<string>韩文</string>
				<string>法文</string>
				<string>德文</string>
				<string>俄文</string>
			</array>
			<key>values</key>
			<array>
				<string>auto</string>
				<string>zh</string>
				<string>en</string>
				<string>ja</string>
				<string>ko</string>
				<string>fr</string>
				<string>de</string>
				<string>ru</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>原文 + 译文一起发送</string>
			<key>key</key>
			<string>YYSendBoth</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示"翻译中…"提示</string>
			<key>key</key>
			<string>YYShowToast</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>用法</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>命令</string>
			<key>value</key>
			<string>翻译:xx / #fy / #fyzh / #fyen / #fyja / #fyko / #fyfr / #fyde / #fyru</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>说明</string>
			<key>value</key>
			<string>百度 App ID/密钥在 fanyi-api.baidu.com 免费申请；不填则自动用谷歌。</string>
		</dict>
	</array>
</dict>
</plist>